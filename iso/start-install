#!/bin/bash
set -euo pipefail

if ! mountpoint -q /run/archiso/bootmnt; then
  echo '[installer] This launcher must run inside the Arch installation medium.' >&2
  exit 1
fi

# A diskless, offline CI VM uses this channel to test the real boot entry.
# Never clone or invoke the destructive installer during that test.
smoke_port=/dev/virtio-ports/org.archlinux.hardened.smoke
if [[ -w "$smoke_port" ]]; then
  printf '%s\n' ARCHLINUX_HARDENED_LAUNCHER_READY >"$smoke_port"
  exit 0
fi

trap 'echo "[installer] Startup failed. Check networking (iwctl for Wi-Fi), then retry: /run/archiso/bootmnt/hardened/start-install" >&2' ERR

network_shell() {
  cat >&2 <<'EOF'

[installer] Could not prepare the installer. Check the error above.
[installer] Opening a shell so you can configure the network and retry.

For Ethernet, plug in the cable; DHCP is configured by the live ISO.
For Wi-Fi, run iwctl and use these commands (replace wlan0 and Network name):
  device list
  station wlan0 scan
  station wlan0 get-networks
  station wlan0 connect "Network name"
  exit
iwctl will ask for the Wi-Fi password when needed.

To diagnose the connection:
  ip address
  ip route
  resolvectl status
  curl --fail --location --max-time 15 https://github.com/ -o /dev/null
For certificate or signature errors, also check the clock with timedatectl.

Exit iwctl first, then type exit (or press Ctrl-D) in this shell to RETRY.
The launcher will retry automatically; do not start another copy in this shell.
To stop the launcher, exit this shell and press Ctrl-C during the retry.
From the normal live shell, you can start again with:
  /run/archiso/bootmnt/hardened/start-install
EOF
  # Avoid login startup files, which could invoke the ISO launcher again.
  bash --noprofile --norc -i || true
}

# A degraded live session may still be usable. Wait for initialization,
# including pacman-init, rather than racing the package manager at login.
state=$(systemctl is-system-running --wait) || true
case "$state" in
  running | degraded) ;;
  *)
    echo "[installer] Live environment is not ready: $state" >&2
    exit 1
    ;;
esac
systemctl start network-online.target

while true; do
  if ! command -v git >/dev/null 2>&1; then
    # The real package download checks mirror connectivity as well as installing Git.
    # This updates only the disposable live environment, never the target disk.
    if ! pacman -Syu --needed --noconfirm git; then
      network_shell
      continue
    fi
  fi

  # Check GitHub access even when Git was already installed. A failed clone gets
  # a fresh destination on retry, so partial downloads cannot block recovery.
  checkout=$(mktemp -d /root/hardened-install.XXXXXX)
  if timeout --foreground --kill-after=5s 120s git clone --depth 1 \
    https://github.com/ShellCode33/ArchLinux-Hardened.git "$checkout/repo"; then
    break
  fi
  network_shell
done
exec "$checkout/repo/install"
