[Unit]
Description=Forward proxy using Glider
# Start the network readiness target for proxy clients during boot.
Wants=network-online.target
After=network.target nftables.service

[Service]
Type=simple
DynamicUser=yes
Group=allow-internet
Restart=always
LimitNOFILE=102400
LogNamespace=glider
ExecStart=/usr/bin/glider -listen http://127.0.0.1:8080 -verbose -logflags 0

[Install]
WantedBy=multi-user.target
