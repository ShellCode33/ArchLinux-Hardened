#!/usr/bin/python3 -u
"""Turn explicit journal requests and selected system events into notifications."""

import asyncio
import contextlib
import html
import json
import logging
import os
import re
from asyncio.subprocess import PIPE
from typing import cast

type Record = dict[str, object]
logger = logging.getLogger("journalctl-notify")
SLEEP_BETWEEN_NOTIFY = 0.1
MAX_MESSAGE_BYTES = 128 * 1024


def field(record: Record, name: str) -> str:
    value = record.get(name)
    return value if isinstance(value, str) else ""


async def send_notify(
    title: str, body: str, urgency: str, icon: str | None = None
) -> None:
    if not title.strip() or urgency not in {"low", "normal", "critical"}:
        raise ValueError("invalid notification title or urgency")
    if any("\0" in value for value in (title, body, icon or "")):
        raise ValueError("notification contains a NUL character")
    if (
        sum(len(value.encode()) for value in (title, body, icon or ""))
        > MAX_MESSAGE_BYTES
    ):
        raise ValueError("notification is too large")
    params = ["/usr/bin/notify-send", "--urgency", urgency]
    if icon:
        params += ["--icon", icon]
    # Treat script and external log messages as text, not notification markup.
    params += ["--", title, html.escape(body)]
    process = await asyncio.create_subprocess_exec(*params)
    try:
        await asyncio.wait_for(process.wait(), timeout=10)
        if process.returncode:
            logger.warning("notify-send exited with status %s", process.returncode)
    finally:
        if process.returncode is None:
            process.terminate()
            await process.wait()
    await asyncio.sleep(SLEEP_BETWEEN_NOTIFY)


async def try_process_notify(record: Record) -> None:
    if field(record, "DESKTOP_NOTIFICATION") == "1":
        await send_notify(
            field(record, "NOTIFY_TITLE"),
            field(record, "MESSAGE"),
            field(record, "NOTIFY_URGENCY"),
            field(record, "NOTIFY_ICON") or None,
        )
        return
    # Compatibility during deployment, including local scripts outside Git.
    message = field(record, "MESSAGE")
    if not message.startswith("NOTIFY "):
        return
    data: object = json.loads(message.removeprefix("NOTIFY "))
    if not isinstance(data, dict):
        raise ValueError("legacy notification must be an object")
    notification = cast(Record, data)
    await send_notify(
        field(notification, "title"),
        field(notification, "body"),
        field(notification, "urgency"),
        field(notification, "icon") or None,
    )


async def try_process_firewall_rejection(line_as_bytes: bytes) -> None:
    # Early return for a line which is not our responsibility to parse
    if line_as_bytes.find(b"FIREWALL REJECTED") == -1:
        return

    line = line_as_bytes.decode().strip()
    tokens = line.split()
    content: dict[str, str] = {}

    for token in tokens:
        key_value = token.split("=")

        if len(key_value) == 1:
            content[key_value[0]] = ""
        elif len(key_value) == 2:
            content[key_value[0]] = key_value[1]
        else:
            error = f"Unable to parse: {key_value} from the following log:\n{line}"
            raise ValueError(error)

    # Process only TCP and UDP
    if "PROTO" not in content or content["PROTO"] not in ("TCP", "UDP"):
        return

    # Don't process rejected broadcast packets (too much spam)
    if "MACDST" in content and content["MACDST"] == "ff:ff:ff:ff:ff:ff":
        return

    # Don't process rejected multicast packets
    if "DST" in content and content["DST"].startswith("224.0.0."):
        return

    try:
        src_addr = content["SRC"]
        _src_port = content["SPT"]
        dst_addr = content["DST"]
        dst_port = content["DPT"]
        proto = content["PROTO"]
        iface_in = content["IN"]
        iface_out = content["OUT"]
    except KeyError as ke:
        error = f"{ke} is missing from the following log:\n{line}"
        raise ValueError(error) from ke

    body = f"{src_addr} tried to reach {dst_addr}:{dst_port} ({proto})\n"

    if "REJECTED FORWARD" in line:
        chain = "FORWARD"
        body += f"From interface {iface_in} to {iface_out}"
    elif "REJECTED INPUT" in line:
        chain = "INPUT"
        body += f"To interface {iface_in}"
    elif "REJECTED OUTPUT" in line:
        # Don't send notification for blocked output (too much spam)
        return
    else:
        error = f"unexpected rejected token from the following log:\n{line}"
        raise ValueError(error)

    await send_notify(f"FIREWALL {chain} DENIED", body, "critical")


async def process_record(record: Record) -> None:
    message = field(record, "MESSAGE")
    if field(record, "_TRANSPORT") == "kernel":
        await try_process_firewall_rejection(message.encode())
        return
    # System requests go to every session running this listener; user requests
    # go only to their own user. Never trust a caller-supplied SYSLOG_IDENTIFIER alone.
    if field(record, "_UID") not in {"0", str(os.getuid())}:
        return
    await try_process_notify(record)
    if (
        field(record, "_UID") == "0"
        and field(record, "_SYSTEMD_UNIT") == "auditd.service"
        and field(record, "SYSLOG_IDENTIFIER") == "auditd"
        and message.startswith("Audit daemon is low on disk space for logging.")
    ):
        await send_notify("LOW ON DISK SPACE", message, "critical")
    if field(record, "_COMM") != "systemd":
        return
    match = re.search(
        r"^([^: ]+): .*?\bcode=(exited|dumped),?\s+status=([^ ,]+)", message
    )
    if match and not (match[2] == "exited" and match[3] == "0/SUCCESS"):
        await send_notify(
            "SYSTEMD SERVICE ISSUE",
            f"{match[1]} {match[2]} with status {match[3]}",
            "critical",
        )


async def read_journal(scope: str, queue: asyncio.Queue[bytes]) -> None:
    # Preserve the existing boot-history replay policy. JSON keeps multiline
    # messages and source metadata intact; a bounded queue limits buffering.
    process = await asyncio.create_subprocess_exec(
        "/usr/bin/journalctl",
        "--boot",
        scope,
        "--follow",
        "--lines=all",
        "--output=json",
        "--all",
        stdout=PIPE,
        limit=1024 * 1024,
    )
    try:
        if process.stdout is None:
            raise RuntimeError("journal reader has no stdout")
        async for line in process.stdout:
            await queue.put(line)
        status = await process.wait()
        raise RuntimeError(f"{scope} journal reader stopped with status {status}")
    finally:
        if process.returncode is None:
            process.terminate()
        await process.wait()


async def consume(queue: asyncio.Queue[bytes]) -> None:
    while True:
        line = await queue.get()
        try:
            data: object = json.loads(line)
            if not isinstance(data, dict):
                raise ValueError("journal entry is not an object")
            await process_record(cast(Record, data))
        except (ValueError, OSError) as error:
            logger.warning("Cannot process journal entry: %s", error)
        finally:
            queue.task_done()


async def main() -> None:
    queue: asyncio.Queue[bytes] = asyncio.Queue(maxsize=128)
    try:
        async with asyncio.TaskGroup() as tasks:
            tasks.create_task(read_journal("--system", queue))
            tasks.create_task(read_journal("--user", queue))
            tasks.create_task(consume(queue))
    except ExceptionGroup:
        logger.exception("Journal monitoring stopped")
        await send_notify(
            "JOURNALCTL NOTIFIER STOPPED",
            "Journal monitoring failed; inspect the service logs.",
            "critical",
        )
        raise


if __name__ == "__main__":
    logging.basicConfig(
        level=logging.INFO, format="[%(name)s] [%(levelname)s] %(message)s"
    )
    with contextlib.suppress(KeyboardInterrupt):
        asyncio.run(main())
