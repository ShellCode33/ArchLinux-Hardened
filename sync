#!/usr/bin/env python3
# pyright: strict
"""Preview and apply tracked rootfs configuration to the installed system."""

import argparse
import difflib
import gzip
import hashlib
import logging
import os
import pwd
import re
import stat
import subprocess
import sys
import tempfile
import zlib
from dataclasses import dataclass, replace
from functools import cache
from pathlib import Path
from typing import ClassVar, override

logger = logging.getLogger("sync")


class ColoredFormatter(logging.Formatter):
    COLORS: ClassVar[dict[int, str]] = {
        logging.DEBUG: "\033[36m",
        logging.INFO: "\033[34m",
        logging.WARNING: "\033[33m",
        logging.ERROR: "\033[31m",
        logging.CRITICAL: "\033[1;31m",
    }

    def __init__(self, use_color: bool) -> None:
        super().__init__("[%(name)s] [%(levelname)s] %(message)s")
        self.use_color = use_color

    @override
    def formatMessage(self, record: logging.LogRecord) -> str:
        message = super().formatMessage(record)
        color = self.COLORS.get(record.levelno) if self.use_color else None
        if color:
            tag = f"[{record.levelname}]"
            message = message.replace(tag, f"{color}{tag}\033[0m", 1)
        return message


def configure_logging() -> None:
    handler = logging.StreamHandler(sys.stderr)
    color = (
        sys.stderr.isatty()
        and "NO_COLOR" not in os.environ
        and os.environ.get("TERM") != "dumb"
    )
    handler.setFormatter(ColoredFormatter(use_color=color))
    logger.handlers.clear()
    logger.addHandler(handler)
    logger.setLevel(logging.INFO)
    logger.propagate = False


@dataclass(frozen=True)
class FileEntry:
    data: bytes
    metadata: os.stat_result


@dataclass(frozen=True)
class SymlinkEntry:
    data: str
    metadata: os.stat_result


type PresentEntry = FileEntry | SymlinkEntry
type Entry = PresentEntry | None
type Change = tuple[Path, Entry, PresentEntry]
type MetadataVersion = tuple[int, int, int, int, int, int, int]
type EntryVersion = tuple[bytes | str, MetadataVersion] | None


class Arguments(argparse.Namespace):
    dry_run: bool
    apply: bool
    yes: bool
    user: str | None


def entry_version(entry: Entry) -> EntryVersion:
    if entry is None:
        return None
    info = entry.metadata
    return entry.data, (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def read_entry(path: Path) -> Entry:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(info.st_mode):
        return SymlinkEntry(os.readlink(path), info)
    if stat.S_ISREG(info.st_mode):
        return FileEntry(path.read_bytes(), info)
    raise ValueError(f"Not a regular file or symlink: {path}")


def check_parents(path: Path) -> None:
    for parent in path.parents:
        if parent.is_symlink():
            raise ValueError(f"Parent directory is a symlink: {parent}")


def render_diff(path: Path, before: Entry, after: PresentEntry) -> str:
    if isinstance(after, SymlinkEntry):
        old = (
            repr(before.data) if isinstance(before, SymlinkEntry) else "(not a symlink)"
        )
        return f"{path}: {old} -> symlink {after.data!r}\n"
    lines = difflib.unified_diff(
        (before.data if isinstance(before, FileEntry) else b"")
        .decode("utf-8", errors="backslashreplace")
        .splitlines(keepends=True),
        after.data.decode("utf-8", errors="backslashreplace").splitlines(keepends=True),
        fromfile=f"{path} (installed)",
        tofile=f"{path} (proposed)",
    )
    heading = f"\n{path}: {'new file' if before is None else 'modified'}\n"
    return heading + "".join(
        line if line.endswith("\n") else line + "\n\\ No newline at end of file\n"
        for line in lines
    )


def save_diffs(changes: list[Change], user: str | None) -> Path | None:
    if not changes:
        return None
    # Keep the diff after exit, private to the user who will review it.
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        prefix="archlinux-sync-",
        suffix=".diff",
        delete=False,
    ) as output:
        path = Path(output.name)
        try:
            output.writelines(render_diff(*change) for change in changes)
            output.flush()
            if os.geteuid() == 0 and user:
                owner = pwd.getpwnam(user)
                os.fchown(output.fileno(), owner.pw_uid, owner.pw_gid)
        except BaseException:
            path.unlink(missing_ok=True)
            raise
    logger.info("Diff written to %s — open it to review the planned changes", path)
    return path


def apply_change(path: Path, before: Entry, after: PresentEntry) -> None:
    check_parents(path)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    # Stage on the destination filesystem, then publish the complete file atomically.
    with tempfile.TemporaryDirectory(
        prefix=".archlinux-sync-", dir=path.parent
    ) as directory:
        staged = Path(directory) / "file"
        if isinstance(after, SymlinkEntry):
            staged.symlink_to(after.data)
        else:
            staged.write_bytes(after.data)
            if before is not None:
                info = before.metadata
                os.chown(staged, info.st_uid, info.st_gid)
                staged.chmod(stat.S_IMODE(info.st_mode))
                for name in os.listxattr(path):
                    os.setxattr(staged, name, os.getxattr(path, name))
            else:
                mode = 0o755 if after.metadata.st_mode & 0o111 else 0o644
                if path == Path("/etc/sudoers") or path.parent == Path(
                    "/etc/sudoers.d"
                ):
                    mode = 0o440
                staged.chmod(mode)
        check_parents(path)
        if entry_version(read_entry(path)) != entry_version(before):
            raise ValueError(f"Destination changed during review: {path}")
        os.replace(staged, path)
    logger.info("Updated %s", path)


def git_paths(repo: Path, *arguments: str) -> list[Path]:
    result = subprocess.run(
        ["git", "-c", f"safe.directory={repo}", *arguments, "--", "rootfs/"],
        cwd=repo,
        stdout=subprocess.PIPE,
        check=True,
    )
    return [Path(os.fsdecode(item)) for item in result.stdout.split(b"\0") if item]


def audit_packages(repo: Path) -> dict[str, str]:
    # Use the actual binary, bypassing the interactive local pacman wrapper.
    query = subprocess.run(
        ["/usr/bin/pacman", "-Q"], capture_output=True, text=True, check=True
    )
    versions = dict(line.split(maxsplit=1) for line in query.stdout.splitlines())
    query = subprocess.run(
        ["/usr/bin/pacman", "-Qqe"], capture_output=True, text=True, check=True
    )
    explicit = set(query.stdout.splitlines())
    listed: set[str] = set()
    for name in ("regular", "aur"):
        for line in (repo / "packages" / name).read_text().splitlines():
            listed.update(line.partition("#")[0].split())
    # These are conditional hardware packages, not required on every machine.
    conditional = set(
        re.findall(
            r"^\s*echo\s+([a-z0-9][a-z0-9@._+-]*)\s*(?:>>\s*(?:regular|aur)_packages_to_install)?\s*$",
            (repo / "install.sh").read_text(),
            re.MULTILINE,
        )
    )
    missing = listed - versions.keys()
    extra = explicit - listed - conditional - {"yay"}
    if missing:
        logger.warning(
            "Listed packages are not installed: %s", ", ".join(sorted(missing))
        )
    if extra:
        logger.warning(
            "Explicitly installed packages are not listed: %s", ", ".join(sorted(extra))
        )
    return versions


def decode_mtree(value: str) -> str:
    # mtree quotes spaces and other special filename bytes with octal escapes.
    return os.fsdecode(
        re.sub(
            rb"\\([0-7]{3})",
            lambda match: bytes((int(match[1], 8),)),
            os.fsencode(value),
        )
    )


def package_file_attributes(manifest: Path, relative: Path) -> dict[str, str]:
    defaults: dict[str, str] = {}
    with gzip.open(
        manifest, "rt", encoding="utf-8", errors="surrogateescape"
    ) as stream:
        text = stream.read().replace("\\\n", "")
    for line in text.splitlines():
        fields = line.split()
        if not fields or fields[0].startswith("#"):
            continue
        attributes = dict(field.split("=", 1) for field in fields[1:] if "=" in field)
        if fields[0] == "/set":
            defaults.update(attributes)
        elif fields[0] == "/unset":
            if "all" in fields[1:]:
                defaults.clear()
            else:
                for name in fields[1:]:
                    defaults.pop(name, None)
        elif decode_mtree(fields[0]).removeprefix("./") == relative.as_posix():
            return defaults | attributes
    raise ValueError("file is absent from the package manifest")


def package_file_matches(attributes: dict[str, str], installed: PresentEntry) -> bool:
    if attributes.get("type") == "link" and "link" in attributes:
        return isinstance(installed, SymlinkEntry) and installed.data == decode_mtree(
            attributes["link"]
        )
    if attributes.get("type") == "file" and "sha256digest" in attributes:
        return (
            isinstance(installed, FileEntry)
            and hashlib.sha256(installed.data).hexdigest() == attributes["sha256digest"]
        )
    raise ValueError(
        "package manifest has no comparable content checksum or symlink target"
    )


@cache
def package_database() -> Path:
    query = subprocess.run(
        ["/usr/bin/pacman-conf", "DBPath"], capture_output=True, text=True, check=True
    )
    return Path(query.stdout.strip()) / "local"


def package_default(
    path: Path, versions: dict[str, str]
) -> tuple[str, dict[str, str]] | None:
    owner = subprocess.run(
        ["/usr/bin/pacman", "-Qoq", "--", str(path)],
        capture_output=True,
        text=True,
        env=os.environ | {"LC_ALL": "C"},
    )
    if owner.returncode == 1 and "No package owns" in owner.stderr:
        return None
    owner.check_returncode()
    package = owner.stdout.strip()
    if package not in versions:
        raise ValueError(f"installed version of {package!r} is unavailable")
    manifest = package_database() / f"{package}-{versions[package]}" / "mtree"
    return package, package_file_attributes(manifest, path.relative_to("/"))


def audit_permissions(
    path: Path, installed: FileEntry, versions: dict[str, str]
) -> None:
    try:
        packaged = package_default(path, versions)
        if packaged is None:
            return
        package, attributes = packaged
        if attributes.get("type") != "file" or "mode" not in attributes:
            raise ValueError(
                "package manifest has no regular-file permissions to compare"
            )
        expected = int(attributes["mode"], 8)
        actual = stat.S_IMODE(installed.metadata.st_mode)
        if actual != expected:
            logger.warning(
                "Permissions differ from package %s: %s (live %04o, packaged %04o); preserving live permissions",
                package,
                path,
                actual,
                expected,
            )
    except (
        OSError,
        ValueError,
        EOFError,
        zlib.error,
        subprocess.CalledProcessError,
    ) as error:
        logger.warning("Cannot verify package permissions for %s: %s", path, error)


def audit_removed_files(
    repo: Path, tracked: set[Path], active: set[Path], versions: dict[str, str]
) -> None:
    removed = set(
        git_paths(
            repo,
            "log",
            "--format=",
            "--name-only",
            "-z",
            "--diff-filter=D",
            "--no-renames",
            "HEAD",
        )
    )
    removed.update(
        git_paths(
            repo,
            "diff",
            "--cached",
            "--name-only",
            "-z",
            "--diff-filter=D",
            "--no-renames",
            "HEAD",
        )
    )
    removed.update(tracked - active)
    for relative in sorted(removed - active):
        destination = Path("/") / relative.relative_to("rootfs")
        try:
            installed = read_entry(destination)
            if installed is None:
                continue
            packaged = package_default(destination, versions)
            if packaged is None:
                logger.warning(
                    "Removed from repository but still present and unowned: %s",
                    destination,
                )
                continue
            package, attributes = packaged
            if not package_file_matches(attributes, installed):
                logger.warning(
                    "Removed from repository; live contents differ from package %s: %s",
                    package,
                    destination,
                )
        except (
            OSError,
            ValueError,
            EOFError,
            zlib.error,
            subprocess.CalledProcessError,
        ) as error:
            logger.warning("Cannot verify removed file %s: %s", destination, error)


def main() -> int:
    configure_logging()
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--dry-run", action="store_true", help="preview changes (default)"
    )
    mode.add_argument(
        "--apply", action="store_true", help="apply changes; requires root"
    )
    parser.add_argument(
        "--yes", action="store_true", help="skip confirmation with --apply"
    )
    parser.add_argument(
        "--user", help="username for placeholders; defaults to SUDO_USER or your login"
    )
    args = parser.parse_args(namespace=Arguments())
    if args.yes and not args.apply:
        parser.error("--yes requires --apply")
    if args.apply and os.geteuid() != 0:
        parser.error("use sudo to apply changes")
    user = args.user or os.environ.get("SUDO_USER")
    if not user and os.getuid() != 0:
        user = pwd.getpwuid(os.getuid()).pw_name
    if user:
        try:
            pwd.getpwnam(user)
        except KeyError:
            parser.error(f"unknown local user: {user}")

    repo = Path(__file__).resolve().parent
    for path in git_paths(repo, "ls-files", "-z", "--others", "--exclude-standard"):
        logger.warning("Ignoring untracked file: %s", path)
    tracked = set(git_paths(repo, "ls-files", "-z"))
    # Include working-tree deletions in the warnings, never in the apply plan.
    active = {
        path for path in tracked if (repo / path).exists() or (repo / path).is_symlink()
    }
    versions: dict[str, str] = {}
    try:
        versions = audit_packages(repo)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        logger.warning("Cannot audit installed packages: %s", error)
    try:
        audit_removed_files(repo, tracked, active, versions)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        logger.warning("Cannot inspect removed-file history: %s", error)
    changes: list[Change] = []
    unchanged = 0
    unreadable = 0
    for relative in sorted(active):
        destination = Path("/") / relative.relative_to("rootfs")
        try:
            source = read_entry(repo / relative)
            check_parents(destination)
            installed = read_entry(destination)
        except PermissionError as error:
            if args.apply:
                raise
            unreadable += 1
            logger.warning(
                "Cannot read %s: %s; skipped (unchecked)",
                error.filename or destination,
                error.strerror or str(error),
            )
            continue
        if source is None:
            raise ValueError(f"Tracked source is missing: {relative}")
        if isinstance(source, FileEntry) and b"username_placeholder" in source.data:
            if not user:
                parser.error("use --user USER when running directly as root")
            source = replace(
                source,
                data=source.data.replace(b"username_placeholder", os.fsencode(user)),
            )
        if isinstance(installed, FileEntry):
            audit_permissions(destination, installed, versions)
        if isinstance(installed, SymlinkEntry) and isinstance(source, FileEntry):
            raise ValueError(
                f"Refusing to overwrite a symlink with a regular file: {destination}"
            )
        if installed is not None and installed.data == source.data:
            unchanged += 1
        else:
            changes.append((destination, installed, source))

    save_diffs(changes, os.environ.get("SUDO_USER") or user)
    logger.info(
        "%d changed, %d unchanged, %d unchecked.", len(changes), unchanged, unreadable
    )
    if unreadable:
        logger.warning(
            "Preview incomplete: %d unreadable file%s. Run with sudo for a complete preview.",
            unreadable,
            "" if unreadable == 1 else "s",
        )
    if not changes:
        return 1 if unreadable else 0
    if not args.apply:
        logger.info("Preview only. Use sudo and --apply to install these changes.")
        return 1 if unreadable else 0
    if not args.yes:
        with open("/dev/tty") as terminal:
            print("Apply all planned changes? [y/N] ", end="", flush=True)
            if terminal.readline().strip().lower() != "y":
                logger.info("No changes applied.")
                return 0
    for destination, installed, _ in changes:
        check_parents(destination)
        if entry_version(read_entry(destination)) != entry_version(installed):
            raise ValueError(f"Destination changed during review: {destination}")
    for change in changes:
        apply_change(*change)
    logger.info("Sync complete. Reload or restart affected services when appropriate.")
    return 0


if __name__ == "__main__":
    os.umask(0o022)
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        logger.error("%s", error)
        sys.exit(1)
    except KeyboardInterrupt:
        logger.warning("Interrupted")
        sys.exit(130)
